{
  "name": "md-reader-workspace",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @mdreader/desktop dev",
    "tauri": "pnpm --filter @mdreader/desktop tauri",
    "lint": "biome ci .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r --if-present run check",
    "check": "pnpm lint && pnpm typecheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@vitest/browser-playwright": "5.0.0",
    "fast-check": "^4.9.0",
    "playwright": "1.63.0",
    "typescript": "~5.9.3",
    "vite": "^8.2.2",
    "vitest": "5.0.0"
  }
}
