{
  "name": "markdown-workspace",
  "private": true,
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @markdown/desktop dev",
    "tauri": "pnpm --filter @markdown/desktop tauri",
    "lint": "biome ci .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r --if-present run check",
    "check": "pnpm lint && pnpm typecheck",
    "test": "vitest run --project '!bench'",
    "test:watch": "vitest",
    "bench": "vitest run --project bench",
    "corpus:gen": "node --env-file-if-exists=.env tools/corpus-gen/generate.mjs",
    "pdf:fixtures": "node tools/pdf-fixtures/generate.mjs",
    "release:version": "node tools/release/set-version.mjs",
    "release:manifest": "node tools/release/main.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@vitest/browser-playwright": "5.0.0",
    "fast-check": "^4.9.0",
    "playwright": "1.63.0",
    "typescript": "~5.9.3",
    "vite": "^8.2.2",
    "vitest": "5.0.0"
  }
}
