{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities of every window. `window-*` must match the labels new_window mints in crates/app, or a second window has no IPC at all.",
  "windows": ["main", "window-*"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-title",
    "dialog:default",
    "opener:allow-open-url",
    "opener:allow-default-urls",
    "updater:default",
    "process:allow-restart"
  ]
}
